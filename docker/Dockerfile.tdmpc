# TDMPC2 Docker Image
# Uses PyTorch base image with CUDA 12.4 support for modern GPUs
FROM pytorch/pytorch:2.5.1-cuda12.4-cudnn9-devel

WORKDIR /workspace

# Install system dependencies for rendering and visualization
RUN apt-get update && apt-get install -y \
    ffmpeg \
    libgl1-mesa-glx \
    libglew-dev \
    x11-xserver-utils \
    xvfb \
    git \
    vim \
    && rm -rf /var/lib/apt/lists/*

# Copy repository
COPY . .

# Install project dependencies
RUN pip install --upgrade pip && \
    pip install --root-user-action=ignore -r requirements.txt

# Patch legacy torch.nn.Buffer usage for modern PyTorch (CRITICAL)
COPY docker/scripts/patch_buffer_docker.sh /tmp/patch_buffer.sh
RUN chmod +x /tmp/patch_buffer.sh && /tmp/patch_buffer.sh

# Set environment variables for GPU rendering
ENV MUJOCO_GL=egl

CMD ["/bin/bash"]